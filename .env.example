NEXT_PUBLIC_APP_ORIGIN=
SESSION_SECRET=

# Supabase (required for cloud mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Vercel OAuth
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
VERCEL_CALLBACK_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Meta Ads
META_APP_ID=
META_APP_SECRET=
META_CALLBACK_URL=

# Stripe billing
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# CMS OAuth (generic — replace with your CMS once chosen)
CMS_CLIENT_ID=
CMS_CLIENT_SECRET=
CMS_CALLBACK_URL=

# AI provider (the app calls an OpenAI-compatible endpoint server-side)
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o
AI_COST_PER_MILLION_INPUT_TOKENS=3
AI_COST_PER_MILLION_OUTPUT_TOKENS=12

# Growth module
GROWTH_SUPERAPH_API_KEY=
GROWTH_SUPERAPH_BASE_URL=
GROWTH_SUPERAPH_MAX_RUN_MINUTES=40
GROWTH_SCOPUS_API_KEY=
GROWTH_SCOPUS_BASE_URL=https://api.elsevier.com/content/search/scopus
GROWTH_GROWTHBOOKS_API_KEY=
GROWTH_GROWTHBOOKS_BASE_URL=

# Publish module
PUBLISH_FACEBOOK_PAGE_ID=
PUBLISH_FACEBOOK_ACCESS_TOKEN=
PUBLISH_INSTAGRAM_ACCOUNT_ID=
PUBLISH_INSTAGRAM_ACCESS_TOKEN=
PUBLISH_X_BEARER_TOKEN=
PUBLISH_LINKEDIN_ACCESS_TOKEN=
PUBLISH_LINKEDIN_PARTNER_TOKEN=
PUBLISH_LINKEDIN_URN=
PUBLISH_MASTODON_ACCESS_TOKEN=
PUBLISH_MASTODON_BASE_URL=https://mastodon.social
PUBLISH_THREADS_ACCESS_TOKEN=
PUBLISH_THINGS_EMAIL=
PUBLISH_THINGS_PASSWORD=

# Cron
CRON_SECRET=

# Optional feature flags
ENABLE_GITHUB_INTEGRATION=true
ENABLE_VERCEL_INTEGRATION=true
ENABLE_GOOGLE_INTEGRATION=true
ENABLE_META_INTEGRATION=true
ENABLE_STRIPE_BILLING=true
