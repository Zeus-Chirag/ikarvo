# ---------- Core ----------
# Public URL of this app, used to build OAuth/Stripe redirect URLs. Leave it unset to use the
# origin the request arrived on (correct for local dev and for Vercel previews). Set it only when
# the app is served from a custom domain, e.g. APP_URL=https://app.ikarvo.com
# A localhost value here is ignored for non-localhost requests, so copying this file cannot point
# a real deployment's OAuth callbacks at your machine.
# APP_URL=
# 32+ random chars. Encrypts GitHub/Vercel tokens in httpOnly cookies. `openssl rand -hex 32`
SESSION_SECRET=

# Dev-only: skip sign-in and keep data in localStorage. Ignored in production builds
# unless ALLOW_PREVIEW_IN_PRODUCTION=1.
PREVIEW_MODE=0

# ---------- Supabase (auth + Postgres) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Needed by the Stripe webhook to update profiles.plan.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI text/code (any OpenAI-compatible API) ----------
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
# Power tiers (OpenRouter ids). Pro falls back to AI_MODEL.
AI_MODEL_FAST=google/gemini-2.5-flash
AI_MODEL_PRO=anthropic/claude-sonnet-4.5
AI_MODEL_MAX=anthropic/claude-opus-4.1
# AI_HTTP_REFERER=http://localhost:3000
# AI_APP_TITLE=Ikarvo

# ---------- GitHub OAuth App ----------
# Callback URL: {APP_URL}/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Vercel ----------
# Option A (multi-user): a Vercel Integration. Redirect URL: {APP_URL}/api/vercel/callback
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
# Option B (single owner): a personal token. Every user deploys to THIS account.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Webhook endpoint: {APP_URL}/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
PRO_PRICE_LABEL=$24

# ---------- Image / video generation (either one) ----------
REPLICATE_API_TOKEN=
FAL_KEY=
# MEDIA_PROVIDER=fal
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
# REPLICATE_VIDEO_MODEL=minimax/video-01
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# FAL_VIDEO_MODEL=fal-ai/kling-video/v1/standard/text-to-video

# ---------- Marketing: publishing & listening ----------
# X: recommended OAuth 1.0a user context (keys never expire): all four values from your app's "Keys and tokens".
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=                   # with X_API_KEY/SECRET set this is the OAuth 1.0a access token; alone it is an OAuth 2.0 user token (expires after 2 h)
X_ACCESS_SECRET=
# LinkedIn: member token with w_member_social, and author URN e.g. urn:li:person:abc123
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# LINKEDIN_API_VERSION=202610   # YYYYMM; LinkedIn sunsets versions after ~1 year. Tokens last 60 days and cannot be refreshed for most apps.
# WordPress: site URL + username + an Application Password (Users → Profile). Articles are sent as drafts.
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
# Reddit: optional "script" app for reliable search (anonymous search is often blocked). Hacker News needs no key.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# AI visibility: comma-separated model IDs to ask (defaults to AI_MODEL), e.g. openai/gpt-4o-mini,anthropic/claude-3.5-haiku,perplexity/sonar
VISIBILITY_MODELS=

# ---- Growth v2 ---------------------------------------------------------------
# Background auto-publisher (Vercel Cron -> /api/cron/publish, see vercel.json).
# Publishes only posts you approved, once due. Single-owner: tokens below belong to one account.
CRON_SECRET=
SCHEDULER_OWNER_USER_ID=          # your Supabase auth user id
# Google Search Console + GA4 (OAuth web client; redirect URI: <APP_URL>/api/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Creator finder
YOUTUBE_API_KEY=
X_BEARER_TOKEN=                   # X app bearer token (recent search)
# Backlink finder: one of
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# Search-grounded AI visibility (else OpenRouter AI_API_KEY uses :online)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
# Social publishing
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS=https://bsky.social
META_GRAPH_VERSION=v26.0          # v21.0 retires 2027-01-21
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=                # IG business account; uses FACEBOOK_PAGE_TOKEN; posts need an image URL
# TikTok Content Posting API. Preferred: client key/secret + refresh token (access tokens last 24 h; refreshed automatically).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=             # valid 365 days; from your OAuth flow with video.upload (+ video.publish after audit)
TIKTOK_ACCESS_TOKEN=              # alternative: a short-lived token, used as-is
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# CMS drafts (all create DRAFTS)
GHOST_URL=
GHOST_ADMIN_API_KEY=              # id:secret
WEBFLOW_TOKEN=
WEBFLOW_COLLECTION_ID=
WEBFLOW_BODY_FIELD=post-body
WEBFLOW_SUMMARY_FIELD=
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_TOKEN=
SANITY_DOC_TYPE=post
SANITY_BODY_FIELD=body
HUBSPOT_TOKEN=
HUBSPOT_BLOG_ID=
HUBSPOT_AUTHOR_ID=
WIX_API_KEY=
WIX_SITE_ID=
WIX_MEMBER_ID=
MEDIUM_TOKEN=                     # Medium no longer issues new integration tokens; existing ones only
# Framer: no write API. Articles export as CSV for Framer CMS import.

# --- Plans & credits (OUR placeholder numbers; set your own) ---
PLAN_FREE_NAME=Starter
PLAN_PRO_NAME=Growth
PLAN_PRO_PRICE_LABEL=             # e.g. "$29/mo"; shown on pricing. Empty = "Set by your Stripe price"
# --- Credits (AI usage metering) ---
CREDITS_FREE_MONTHLY=150
CREDITS_PRO_MONTHLY=1000
# PREVIEW_PLAN=pro   # preview-mode plan for the in-memory ledger
# --- Site audit / notifications (all optional; routes return 503 setup steps when missing) ---
PAGESPEED_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=

# ---------- Ad Studio (all optional; each returns 503 with the exact missing keys) ----------
# Voiceover
ELEVENLABS_API_KEY=               # returns word timestamps -> exact captions
ELEVENLABS_VOICE_ID=              # default: a stock library voice
ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_API_KEY=                   # OpenAI TTS (captions are estimated; no timestamps)
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# AI avatar / actor video (generated on YOUR provider account)
HEYGEN_API_KEY=                   # uses API v3 (v1/v2 retire 2026-10-31)
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
SYNTHESIA_API_KEY=
SYNTHESIA_AVATAR=
SYNTHESIA_VOICE_ID=
SYNTHESIA_TEST=true               # test videos are watermarked and free; set false for real renders
CREATIFY_API_ID=
CREATIFY_API_KEY=
CREATIFY_CREATOR_ID=
CREATIFY_ACCENT_ID=
CREATIFY_MODEL=
# Ad delivery (video upload)
META_AD_ACCOUNT_ID=               # numbers only, without act_
META_ADS_TOKEN=                   # system-user token with ads_management
# Facebook Page video uses FACEBOOK_PAGE_ID / FACEBOOK_PAGE_TOKEN above; YouTube uses the Google connection with "Add YouTube" (youtube.upload)

# ---------- Meta Ads (Marketing API) · Integrations → Meta Ads, Marketing → Meta Ads ----------
# A Meta app of type "Business" with the Marketing API product and Facebook Login for Business.
# Valid OAuth redirect URI: {APP_URL}/api/meta/callback. Scopes requested: ads_management, ads_read,
# business_management (+ pages_show_list, pages_read_engagement to pick the Page ads run as).
# ads_management for other people's accounts needs Advanced Access via App Review.
META_APP_ID=
META_APP_SECRET=
# Optional: a Facebook Login for Business configuration id (replaces the scope list in the dialog).
# META_LOGIN_CONFIG_ID=
# Optional: Graph API version (default v26.0).
# META_GRAPH_VERSION=v26.0
# Optional single-owner fallback: a system-user token instead of per-workspace OAuth.
# (Also used by Ad Studio → Deliver → "Meta ad account".) META_APP_ID/SECRET are still required.
# META_ADS_TOKEN=
# META_AD_ACCOUNT_ID=
# FACEBOOK_PAGE_ID=
# Tests only: point Graph/OAuth at a mock server. Never set in production.
# META_GRAPH_BASE=
# META_GRAPH_VIDEO_BASE=
# META_OAUTH_BASE=

# ---------- UGC v11: extra avatar / captions / music providers ----------
DID_API_KEY=                      # D-ID talks API (Basic auth value from the D-ID studio)
DID_SOURCE_URL=                   # default public https portrait for D-ID
DID_VOICE_ID=                     # e.g. en-US-JennyNeural (Microsoft voice via D-ID)
FAL_KEY=                          # also enables OmniHuman, LatentSync, SadTalker lip-sync, Wizper captions, Stable Audio music
HF_API_KEY_ID=                    # Higgsfield API key id (docs.higgsfield.ai) – Soul presenter portraits
HF_API_KEY_SECRET=
HIGGSFIELD_IMAGE_MODEL=higgsfield-ai/soul/v2/standard
# OPENAI_API_KEY (above) also enables Whisper word-level captions; ELEVENLABS_API_KEY also enables ElevenLabs Music
